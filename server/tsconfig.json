{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ESNext", "ES2020", "ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "outDir": "dist"
  },
  "include": ["src/**/*", "swagger.yml"],
  "exclude": [
    "node_modules",
    "src/tests",
    "src/lib/__mocks__",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
