{
  "name": "@resala/server",
  "version": "1.0.0",
  "description": "Resala server",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "prisma:generate": "npx prisma generate",
    "build": "npm run prisma:generate && tsc -b",
    "start": "dotenv -e .env -- ts-node --transpile-only src/index.ts",
    "dev": "dotenv -e .env.dev -- nodemon  --exec ts-node src/index.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "dotenv -e .env.test -- jest"
  },
  "keywords": [],
  "author": "Hossam Hamdy",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.0.1",
    "@azure/storage-blob": "^12.17.0",
    "@prisma/client": "^5.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "nodemon": "^3.0.3",
    "prisma": "^5.11.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "schema": "src/model/schema.prisma",
    "seed": "ts-node src/model/seed.ts"
  }
}
