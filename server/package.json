{
  "name": "@resala/server",
  "version": "1.0.0",
  "description": "Resala server",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prisma:generate": "npx prisma generate",
    "build": "npm i && npm run prisma:generate && tsc",
    "start": "set NODE_ENV=prod && node dist/index.js",
    "dev": "set NODE_ENV=dev && tsx watch src/index.ts",
    "test:unit": "dotenv -e .env.test -- vitest -c ./vitest.config.unit.ts",
    "test:integration": "./scripts/run-integration.sh",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "Hossam Hamdy",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.0.1",
    "@azure/storage-blob": "^12.17.0",
    "@prisma/client": "^5.12.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.12.1",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "vitest": "^1.5.0",
    "vitest-mock-extended": "^1.3.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=16"
  }
}
