// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------ //
//*             User Data                *//

model User {
  id            String         @id @default(uuid())
  email         String         @unique @db.VarChar(125)
  isVerified    Boolean        @default(false)
  phone         String?        @unique @db.Char(11)
  firstName     String         @db.VarChar(50)
  lastName      String         @db.VarChar(50)
  role          Role           @default(CUSTOMER)
  password      String         @db.VarChar(500)
  salt          String         @db.VarChar(500)
  iterations    Int
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  cart          Cart[]
  wishlist      Wishlist[]
  addressList   UserAddress[]
  reviews       Review[]
  orders        Order[]
  notifications Notification[]
}

model UserAddress {
  userId    String  @db.Char(36)
  addressId Int     @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@id([userId, addressId])
}

// ------------------------------------------------ //
//*             Inventory Data                *//
model Category {
  id            String     @id @default(uuid())
  categoryId    String?    @db.Char(36)
  arName        String     @unique @db.VarChar(100)
  enName        String     @unique @db.VarChar(100)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  products      Product[]
  subCategories Category[] @relation("SubCategories")
  mainCategory  Category?  @relation("SubCategories", fields: [categoryId], references: [id])
}

model Product {
  id            String         @id @default(uuid())
  categoryId    String         @db.Char(36)
  arName        String         @unique @db.VarChar(50)
  enName        String         @unique @db.VarChar(50)
  arDescription String         @db.VarChar(1000)
  enDescription String         @db.VarChar(1000)
  price         Decimal        @db.Decimal(9, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  category      Category       @relation(fields: [categoryId], references: [id])
  stocks        Stock[]
  wishlist      Wishlist[]
  images        ProductImage[]
  reviews       Review[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId String   @db.Char(36)
  imageUrl  String   @db.VarChar(500)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId String   @db.Char(36)
  colorId   Int
  sizeId    Int
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  color     Color    @relation(fields: [colorId], references: [id])
  size      Size     @relation(fields: [sizeId], references: [id])
  cart      Cart[]

  @@unique([productId, colorId, sizeId], name: "stock_unique_constraint")
}

model Color {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.Char(7)
  arName    String   @unique @db.VarChar(15)
  enName    String   @unique @db.VarChar(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stocks    Stock[]
}

model Size {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(5) // S, M, L, XL, XXL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stocks    Stock[]
}

// ------------------------------------------------ //
//*             Shopping Data                *//
model Cart {
  userId    String   @db.Char(36)
  stockId   Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@id([userId, stockId])
}

model Wishlist {
  userId    String   @db.Char(36)
  productId String   @db.Char(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ------------------------------------------------ //
//*             Order Data                *//
model Order {
  id         String      @id @default(uuid())
  userId     String      @default("User") @db.Char(36)
  subtotal   Decimal     @db.Decimal(9, 2)
  discount   Decimal     @default(0) @db.Decimal(9, 2)
  total      Decimal?    @db.Decimal(9, 2)
  status     OrderStatus @default(PENDING)
  note       String?     @db.VarChar(250)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: SetDefault)
  orderItems OrderItem[]
  shipping   Shipping?
  payment    Payment?
}

model OrderItem {
  orderId   String   @id @db.Char(36)
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(15)
  size      String   @db.VarChar(5)
  quantity  Int
  price     Decimal  @db.Decimal(9, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
}

model Shipping {
  orderId   String         @unique @db.Char(36)
  addressId Int            @unique
  cost      Decimal        @db.Decimal(9, 2)
  phone     String         @db.Char(11)
  status    ShippingStatus @default(PICKED_UP)
  note      String?        @db.VarChar(250)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  order     Order          @relation(fields: [orderId], references: [id])
  address   Address        @relation(fields: [addressId], references: [id])

  @@id([orderId, addressId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  orderId   String        @unique @db.Char(36)
  method    String        @db.VarChar(15)
  amount    Decimal       @db.Decimal(9, 2)
  status    PaymentStatus @default(PENDING)
  note      String?       @db.VarChar(250)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])
}

// ------------------------------------------------ //
//*             Review Data                *//
model Review {
  id        Int      @id @default(autoincrement())
  userId    String   @default("User") @db.Char(36)
  productId String   @db.Char(36)
  rating    Int      @default(5)
  comment   String?  @db.VarChar(250)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: SetDefault)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------ //
//*             Notification Data                *//
model Notification {
  id        String   @id @default(uuid())
  userId    String   @db.Char(36)
  title     String   @db.VarChar(25)
  content   String   @db.VarChar(250)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------ //
//*             Utils                *//

model Address {
  id          Int          @id @default(autoincrement())
  country     String       @default("Egypt") @db.VarChar(50)
  state       String       @db.VarChar(50)
  city        String       @db.VarChar(50)
  street      String       @db.VarChar(100)
  building    String?      @db.VarChar(50)
  floor       Int?         @db.SmallInt
  note        String?      @db.VarChar(200)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userAddress UserAddress?
  shipping    Shipping?
}

enum Role {
  ADMIN
  MODERATOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ShippingStatus {
  PICKED_UP
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}
