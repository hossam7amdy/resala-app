{
  "name": "resala",
  "description": "Resala App",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "shared",
    "dashboard"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "yarn format:check && yarn lint:check",
    "checks:fix": "yarn format && yarn lint",
    "build:shared": "yarn --cwd shared build",
    "build:server": "yarn --cwd server build",
    "build:dashboard": "yarn --cwd dashboard build",
    "build": "npm-run-all build:shared build:server build:dashboard",
    "test:server": "yarn --cwd server test",
    "test:dashboard": "yarn --cwd dashboard test",
    "test": "npm-run-all --parallel test:server test:dashboard",
    "start:dashboard": "yarn --cwd dashboard dev",
    "start:server": "yarn --cwd server dev",
    "start": "npm-run-all --parallel start:server start:dashboard",
    "start:server:prod": "yarn --cwd server start",
    "docker:build:server": "docker build -t hossam7amdy/resala-server . -f Dockerfile.server"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.00",
    "npm": "use yarn instead"
  }
}
