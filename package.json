{
  "name": "resala",
  "description": "Resala App",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pre-commit": "yarn checks:fix",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "yarn format:check && yarn lint:check",
    "checks:fix": "yarn format && yarn lint",
    "build:shared": "yarn workspace @resala/shared build",
    "build:server": "yarn workspace @resala/server build",
    "build:dashboard": "yarn workspace @resala/dashboard build",
    "build:web": "yarn workspace @resala/web build",
    "build": "npm-run-all build:shared build:server build:dashboard build:web",
    "test:server": "yarn workspace @resala/server test",
    "test:dashboard": "yarn workspace @resala/dashboard test",
    "test:web": "yarn workspace @resala/web test",
    "test": "npm-run-all --parallel test:server test:dashboard test:web",
    "start:dashboard:dev": "yarn workspace @resala/dashboard dev",
    "start:dashboard": "yarn workspace @resala/dashboard start",
    "start:web:dev": "yarn workspace @resala/web ng serve --open",
    "start:web": "yarn workspace @resala/web start",
    "start:server:dev": "yarn workspace @resala/server dev",
    "start:server": "yarn workspace @resala/server start",
    "docker:build:server": "docker build -t hossam7amdy/resala-server . -f Dockerfile.server"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
