{
  "name": "resala",
  "description": "Resala App",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 300",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "build:shared": "yarn workspace @resala/shared build",
    "build:dashboard": "yarn workspace @resala/dashboard build",
    "build:web": "yarn workspace @resala/web build",
    "build": "yarn workspaces run build",
    "test:shared": "yarn workspace @resala/shared test",
    "test:dashboard": "yarn workspace @resala/dashboard test",
    "test:web": "yarn workspace @resala/web test",
    "test": "npm-run-all --parallel test:shared test:dashboard test:web",
    "start:dashboard:dev": "yarn workspace @resala/dashboard dev",
    "start:dashboard": "yarn workspace @resala/dashboard start",
    "start:web:dev": "yarn workspace @resala/web ng serve --open",
    "start:web": "yarn workspace @resala/web start",
    "compose:down": "docker-compose -f docker-compose.yml down",
    "compose:up": "docker-compose -f docker-compose.yml up"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "typescript": "~5.1.0"
  }
}
