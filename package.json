{
  "name": "resala",
  "description": "Resala App",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "shared",
    "dashboard",
    "web"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "prettier . --write",
    "lint:check": "prettier . --check",
    "build:server": "cd server && npm run build",
    "build:shared": "cd shared && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "build": "npm i && npm-run-all build:server",
    "test:server": "cd server && npm run test",
    "test:dashboard": "cd dashboard && npm run test --if-present",
    "test": "npm-run-all --parallel test:server",
    "start:dashboard": "cd dashboard && npm run dev",
    "start:server": "cd server && npm run dev"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
