pipeline {
    agent any

    tools {
      nodejs "NodeJS21.7.1"
    }

    stages {
        stage('Build') { 
            steps {
                sh 'yarn build'
            }
        }
        stage('Test') {
            steps {
                sh 'yarn test'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'yarn docker:build:server'
            }
        }
    }
}