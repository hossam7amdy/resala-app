pipeline {
    agent any

    tools {
      nodejs "NodeJS21.7.1"
    }

    stages {
        stage('Build') { 
            steps {
                sh 'npm run build:server'
            }
        }
        stage('Test') {
            steps {
                sh 'npm run test:server'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'npm run docker:build:server'
            }
        }
    }
}