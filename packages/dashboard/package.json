    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.0.0",
    "@resala/shared": "*",
    "antd": "^5.21.2",
    "better-auth": "^1.0.4",
    "chart.js": "^4.4.4",
