{
  "name": "@resala/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./features": {
      "import": {
        "types": "./dist/features.d.ts",
        "default": "./dist/features.js"
      }
    }
  },
  "scripts": {
    "postinstall": "yarn prisma generate",
    "dev": "yarn prisma generate && next dev --turbopack -p 5000",
    "tsup": "tsup --clean --dts --minify",
    "build": "yarn prisma generate && next build && yarn tsup",
    "clean": "rm -rf .next && rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint --no-cache",
    "test": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/client-ses": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.3",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.0.0",
    "@resala/shared": "*",
    "better-auth": "^1.1.6",
    "hono": "^4.6.12",
    "libphonenumber-js": "^1.11.15",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.1.3",
    "postcss": "^8.4.47",
    "prisma": "^6.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.1.0",
    "vitest": "^2.1.6",
    "tsup": "^8.3.5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "resolutions": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2"
  }
}
