generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  emailVerified       Boolean        @default(false) @map("email_verified")
  emailMarketingState MarketingState @default(not_subscribed) @map("email_marketing_state")
  phoneNumber         String?        @unique @map("phone_number")
  phoneNumberVerified Boolean        @default(false) @map("phone_number_verified")
  smsMarketingState   MarketingState @default(not_subscribed) @map("sms_marketing_state")
  name                String         @default("")
  firstName           String         @map("first_name")
  lastName            String         @map("last_name")
  role                Role           @default(user)
  banned              Boolean?
  banReason           String?        @map("ban_reason")
  banExpires          DateTime?      @map("ban_expires")
  isAnonymous         Boolean?       @map("is_anonymous")
  image               String?
  note                String?
  locale              String?        @default("en_US")
  birthDate           DateTime?      @map("birth_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  accounts            Account[]
  sessions            Session[]
  cart                Cart[]
  orders              Order[]
  reviews             Review[]
  addresses           UserAddress[]
  wishlist            Wishlist[]

  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  idToken               String?   @map("id_token")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model UserAddress {
  addressId String  @unique @map("address_id")
  userId    String  @map("user_id")
  isDefault Boolean @default(false) @map("is_default")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, addressId])
  @@map("user_address")
}

model Category {
  id            String    @id @default(cuid())
  arName        String    @map("ar_name")
  enName        String    @map("en_name")
  mediaId       String?   @map("media_id")
  arDescription String?   @map("ar_description")
  enDescription String?   @map("en_description")
  activateAt    DateTime? @default(now()) @map("activated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  products      Product[]

  @@map("category")
}

model Product {
  id            String         @id @default(cuid())
  arName        String         @map("ar_name")
  enName        String         @map("en_name")
  arDescription String         @map("ar_description")
  enDescription String         @map("en_description")
  mediaId       String         @map("media_id")
  price         Decimal        @db.Decimal(10, 2)
  activateAt    DateTime?      @default(now()) @map("activate_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  categories    Category[]
  discounts     Discount[]
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]
  stocks        Stock[]
  wishlist      Wishlist[]

  @@map("product")
}

model ProductImage {
  colorId   String   @map("color_id")
  mediaId   String   @map("media_id")
  productId String   @map("product_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  color     Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, colorId, mediaId])
  @@map("product_image")
}

model Stock {
  id         String      @id @default(cuid())
  productId  String      @map("product_id")
  colorId    String      @map("color_id")
  sizeId     String      @map("size_id")
  quantity   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  cart       Cart[]
  orderItems OrderItem[]
  color      Color       @relation(fields: [colorId], references: [id])
  size       Size        @relation(fields: [sizeId], references: [id])
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId, sizeId], name: "stock_unique_constraint")
  @@map("stock")
}

model Color {
  id        String         @id @default(cuid())
  code      String         @unique @db.Char(7)
  arName    String         @unique @map("ar_name") @db.VarChar(15)
  enName    String         @unique @map("en_name") @db.VarChar(15)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  stocks    Stock[]
  images    ProductImage[]

  @@map("color")
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  stocks    Stock[]

  @@map("size")
}

model Cart {
  stockId   String   @map("stock_id")
  userId    String   @map("user_id")
  quantity  Int      @default(1) @map("quantity")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, stockId])
  @@map("cart")
}

model Wishlist {
  productId String   @map("product_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlist")
}

model Order {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  userId          String        @map("user_id")
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  transactionId   String?       @map("transaction_id") @db.VarChar(32)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  note            String?       @db.VarChar(250)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  shippingDetails Shipping?

  @@map("order")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  stockId   String   @map("stock_id")
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  stock     Stock    @relation(fields: [stockId], references: [id])

  @@map("order_item")
}

model Shipping {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  addressId String   @unique @map("address_id")
  cost      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  address   Address  @relation(fields: [addressId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("shipping")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String?  @map("media_id")
  productId String   @map("product_id")
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review")
}

model Address {
  id                     String       @id @default(cuid())
  country                String       @default("Egypt")
  state                  String
  city                   String
  street                 String
  building               String?
  floor                  Int?         @db.SmallInt
  address                String?
  phone                  String
  firstName              String       @map("first_name")
  lastName               String       @map("last_name")
  createdAt              DateTime     @default(now()) @map("created_at")
  company                String?
  countryCode            String?      @default("EG") @map("country_code")
  latitude               Float?       @db.DoublePrecision
  longitude              Float?       @db.DoublePrecision
  isCoordinatesValidated Boolean      @default(false) @map("is_coordinates_validated")
  zip                    String?      @map("zip")
  address2               String?
  updatedAt              DateTime     @updatedAt @map("updated_at")
  userAddress            UserAddress?
  shipping               Shipping?

  @@map("address")
}

model Discount {
  id          String       @id @default(cuid())
  type        DiscountType @map("type")
  amount      Decimal      @db.Decimal(10, 2)
  description String?      @db.VarChar(250)
  minQty      Int          @default(1) @map("min_qty")
  isActive    Boolean      @default(true) @map("is_active")
  isStoreWide Boolean      @default(false) @map("is_store_wide")
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  products    Product[]

  @@map("discount")
}

enum DiscountType {
  PERCENTAGE
  FIXED
  BOGO
  BULK

  @@map("discount_type")
}

enum MediaContentType {
  image
  video

  @@map("media_content_type")
}

enum OrderStatus {
  PENDING
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  VOIDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  CARD

  @@map("payment_method")
}

enum MarketingState {
  subscribed
  unsubscribed
  not_subscribed

  @@map("marketing_state")
}

enum Role {
  admin
  staff
  user

  @@map("role")
}
