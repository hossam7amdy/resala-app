model Category {
  id            String    @id @default(cuid())
  arName        String    @map("ar_name")
  enName        String    @map("en_name")
  mediaId       String?   @map("media_id")
  arDescription String?   @map("ar_description")
  enDescription String?   @map("en_description")
  activateAt    DateTime? @default(now()) @map("activated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  products      Product[]

  @@map("category")
}

model Product {
  id            String         @id @default(cuid())
  arName        String         @map("ar_name")
  enName        String         @map("en_name")
  arDescription String         @map("ar_description")
  enDescription String         @map("en_description")
  mediaId       String         @map("media_id")
  price         Decimal        @db.Decimal(10, 2)
  activateAt    DateTime?      @default(now()) @map("activate_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  categories    Category[]
  discounts     Discount[]
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]
  stocks        Stock[]
  wishlist      Wishlist[]

  @@map("product")
}

model ProductImage {
  colorId   String   @map("color_id")
  mediaId   String   @map("media_id")
  productId String   @map("product_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  color     Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, colorId, mediaId])
  @@map("product_image")
}

model Stock {
  id         String      @id @default(cuid())
  productId  String      @map("product_id")
  colorId    String      @map("color_id")
  sizeId     String      @map("size_id")
  quantity   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  cart       Cart[]
  orderItems OrderItem[]
  color      Color       @relation(fields: [colorId], references: [id])
  size       Size        @relation(fields: [sizeId], references: [id])
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId, sizeId], name: "stock_unique_constraint")
  @@map("stock")
}

model Color {
  id        String         @id @default(cuid())
  code      String         @unique @db.Char(7)
  arName    String         @unique @map("ar_name") @db.VarChar(15)
  enName    String         @unique @map("en_name") @db.VarChar(15)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  stocks    Stock[]
  images    ProductImage[]

  @@map("color")
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  stocks    Stock[]

  @@map("size")
}
