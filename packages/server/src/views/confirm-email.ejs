<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <style>
        :root {
            --primary-color: rgb(2, 99, 117);
            --primary-color-light: rgb(2, 99, 117, 0.1);
            --border-radius: 12px;
            --shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            --font-size: 16px;
            --font-weight: 400;
            --line-height: 1.5;
            --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif,
                "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol",
                "Noto Color Emoji";
            --font-mono: ui-monospace, Menlo, Monaco, "Cascadia Mono",
                "Segoe UI Mono", "Roboto Mono", "Oxygen Mono", "Ubuntu Monospace",
                "Source Code Pro", "Fira Mono", "Droid Sans Mono", "Courier New",
                monospace;
        }

        * {
            box-sizing: border-box;
            -webkit-box-sizing: border-box;
            -ms-box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            max-width: 100vw;
            overflow-x: hidden;
            color-scheme: light;
        }

        body {
            width: 100vw;
            height: 100vh;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px;
            font-size: var(--font-size);
            font-weight: var(--font-weight);
            line-height: var(--line-height);
            font-family: var(--font-sans);
        }

        header {
            margin-bottom: 40px;
        }

        main {
            flex: 1;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        .links a {
            display: inline-block;
            margin: 10px;
            padding: 15px 30px;
            background-color: var(--primary-color);
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1.2em;
            transition: background-color 0.3s;
        }

        .links a:hover {
            background-color: rgb(2, 99, 117, 0.85);

        }

        .success {
            color: green;
        }

        .error {
            color: orangered;
        }

        .error,
        .success {
            font-size: 1.5rem;
            text-align: center;
            font-weight: 500;
        }

        footer {
            display: flex;
            gap: 20px;
            justify-content: space-between;
            margin-top: 50px;
            font-size: 0.9em;
            color: #555;

        }

        @media (prefers-color-scheme: light) {
            html {
                color-scheme: light;
            }
        }

        @Media screen and (max-width: 600px) {
            h1 {
                font-size: 2em;
            }

            .links a {
                padding: 15px 20px;
                width: 100%;
            }

            footer {
                flex-direction: column;
            }
        }
    </style>

    <title>Confirm Email | Resala</title>
</head>

<body>
    <header>
        <img src="/assets/logo.png" alt="Logo" width="150" />
    </header>

    <main>

        <% if (success) { %>
            <div class="success">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                    <path fill="currentColor"
                        d="m10.6 16.6l7.05-7.05l-1.4-1.4l-5.65 5.65l-2.85-2.85l-1.4 1.4zM12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22m0-2q3.35 0 5.675-2.325T20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20m0-8" />
                </svg>
                <p>
                    <%= success %>
                </p>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 16 16">
                            <g fill="currentColor">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                                <path
                                    d="M7.002 11a1 1 0 1 1 2 0a1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                            </g>
                        </svg>
                        <p>
                            <%= error %>
                        </p>
                    </div>
                    <% } %>

    </main>

    <footer>
        <p>
            &copy; <span>
                <%= year %>
            </span> Team. All rights reserved.
        </p>
    </footer>
</body>

</html>