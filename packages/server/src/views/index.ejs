<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <style>
        :root {
            --primary-color: rgb(2, 99, 117);
            --primary-color-light: rgb(2, 99, 117, 0.1);
            --border-radius: 12px;
            --shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            --font-size: 16px;
            --font-weight: 400;
            --line-height: 1.5;
            --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif,
                "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol",
                "Noto Color Emoji";
            --font-mono: ui-monospace, Menlo, Monaco, "Cascadia Mono",
                "Segoe UI Mono", "Roboto Mono", "Oxygen Mono", "Ubuntu Monospace",
                "Source Code Pro", "Fira Mono", "Droid Sans Mono", "Courier New",
                monospace;
        }

        * {
            box-sizing: border-box;
            -webkit-box-sizing: border-box;
            -ms-box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            max-width: 100vw;
            overflow-x: hidden;
            color-scheme: light;
        }

        body {
            width: 100vw;
            height: 100vh;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px;
            font-size: var(--font-size);
            font-weight: var(--font-weight);
            line-height: var(--line-height);
            font-family: var(--font-sans);
        }

        header {
            margin-bottom: 40px;
        }

        main {
            flex: 1;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        .links a {
            display: inline-block;
            margin: 10px;
            padding: 15px 30px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1.2em;
        }

        .links a:hover {
            background-color: #0056b3;
        }

        footer {
            display: flex;
            gap: 20px;
            justify-content: space-between;
            margin-top: 50px;
            font-size: 0.9em;
            color: #555;

        }

        @media (prefers-color-scheme: light) {
            html {
                color-scheme: light;
            }
        }

        @Media screen and (max-width: 600px) {
            h1 {
                font-size: 2em;
            }

            .links a {
                padding: 15px 20px;
            }

            footer {
                flex-direction: column;
            }
        }
    </style>

    <title>Welcome to our API server | Resala</title>
</head>

<body>
    <header>
        <img src="/assets/logo.png" alt="Logo" width="150" />
        <h1>Welcome to Our Server</h1>
        <p>Access our web app, admin dashboard, and API documentation below.</p>
    </header>

    <main>
        <div class="links">
            <a href="<%= webAppUrl %>">Go to web app</a>
            <a href="<%= adminDashboardUrl %>">Go to admin dashboard</a>
            <a href="/api-docs">View API documentation</a>
        </div>
    </main>

    <footer>
        <p>
            &copy; <span>
                <%= year %>
            </span> Team. All rights reserved.
        </p>
        <div>Server Status: 🟢<strong>Online</strong> | Uptime: <span>
                <%= uptime %>
            </span></div>
    </footer>
</body>

</html>