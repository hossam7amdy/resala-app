{
  "name": "@resala/server",
  "version": "1.0.0",
  "description": "Resala server",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "yarn db:generate && rm -r -f dist/* && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "DOTENV_CONFIG_PATH=.env.test vitest -c ./vitest.config.ts",
    "db:generate": "yarn prisma generate && tsc",
    "db:seed": "tsx src/datastore/prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset --force",
    "routes:generate": "tsoa spec-and-routes && tsx src/routes/api.routes.fix.ts && tsc"
  },
  "keywords": [],
  "author": "Hossam Hamdy",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.574.0",
    "@prisma/client": "^5.19.0",
    "axios": "^1.7.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.4.0",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.11.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.19.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.5.4",
    "vitest": "^1.5.0",
    "vitest-mock-extended": "^1.3.1"
  },
  "prisma": {
    "schema": "src/datastore/prisma/schema.prisma"
  }
}
