{
  "entryFile": "src/app.ts",
  "defaultNumberType": "integer",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/features/**/*.controller.ts"],
  "spec": {
    "yaml": true,
    "outputDirectory": "docs",
    "specVersion": 3,
    "specMerging": "recursive",
    "spec": {
      "components": {
        "securitySchemes": {
          "JWT_SECRET": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT"
          },
          "JWT_VERIFY": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT"
          },
          "JWT_RESET": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT"
          }
        }
      },
      "servers": [
        {
          "url": "http://localhost:5000",
          "description": "Local development"
        },
        {
          "url": "https://www.resala.live",
          "description": "Development server"
        }
      ]
    }
  },
  "routes": {
    "esm": true,
    "middleware": "express",
    "routesDir": "src/routes",
    "routesFileName": "api.routes.ts",
    "authenticationModule": "./src/middlewares/authentication.ts"
  }
}
