PORT=5000
NODE_ENV=test
APP_URL=http://localhost:5000

# JWT
JWT_SECRET=test_secret
JWT_REFRESH=test_refresh
JWT_RESET=test_reset
JWT_VERIFY=test_verify

# MAIN DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:54320/resala

# GOOGLE APP CREDENTIALS FOR GOOGLE MAILING SERVICE
MAIL_USER=mail_user
MAIL_PASS=mail_pass

# TWILIO CREDENTIALS
TWILIO_ACCOUNT_SID=twilio_account_sid
TWILIO_AUTH_TOKEN=twillio_auth_token
TWILIO_PHONE_NUMBER=twilio_phone_number

# PayMob Gateway Credentials
PAYMOB_INTEGRATION_ID=12345
PAYMOB_API_URL=https://accept.paymob.com/api
PAYMOB_HMAC_KEY=hmac_key
PAYMOB_API_TOKEN=token

# AWS S3
AWS_ACCESS_KEY_ID=minio_key
AWS_SECRET_ACCESS_KEY=minio_secret
S3_REGION=s3_region
S3_BUCKET=bucket_name
S3_ENDPOINT='http://localhost:9000'
S3_BASE_URL='http://localhost:9000/bucket_name'
